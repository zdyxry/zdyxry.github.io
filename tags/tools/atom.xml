&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;--------------------------------------------------------------------------------
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;root@yiran-workstation:~/go/src/github.com/kubernetes-sigs/cluster-api-provider-vsphere
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;master ✗ $ ls
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;boilerplate.go.txt cmd config Dockerfile go.mod hack Makefile OWNERS_ALIASES PROJECT RELEASE.md SECURITY_CONTACTS
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;build code-of-conduct.md CONTRIBUTING.md docs go.sum LICENSE OWNERS pkg README.md scripts vendor
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;root@yiran-workstation:~/go/src/github.com/kubernetes-sigs/cluster-api-provider-vsphere
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;master ✗ $ cloc . --exclude-dir=vendor
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; 234 text files.
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; 234 unique files.
