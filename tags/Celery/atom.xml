&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="font-weight:bold">return&lt;/span> self.fun(resource, callback, **kwargs)
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> File &lt;span style="font-style:italic">&amp;#34;/usr/lib/python2.7/site-packages/kombu/transport/virtual/base.py&amp;#34;&lt;/span>, line 405, in _get_and_deliver
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> message = self._get(queue)
