&lt;span class=&quot;line&quot;&gt;&lt;span style=&quot;color:#B392F0&quot;&gt;    link/loopback&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; 00:00:00:00:00:00&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; brd&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; 00:00:00:00:00:00&lt;/span&gt;&lt;/span&gt;
