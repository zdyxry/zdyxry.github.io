&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>getitem name is d
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>d not in self
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>init kwargs is {&amp;#39;__key&amp;#39;: &amp;#39;d&amp;#39;, &amp;#39;__parent&amp;#39;: {&amp;#39;c&amp;#39;: &amp;#39;c&amp;#39;}}
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>setitem name is e, value is e
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>parent is {&amp;#39;c&amp;#39;: &amp;#39;c&amp;#39;}
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>key is d
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>setitem name is d, value is {&amp;#39;e&amp;#39;: &amp;#39;e&amp;#39;}
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>{&amp;#39;a&amp;#39;: &amp;#39;a&amp;#39;, &amp;#39;b&amp;#39;: {&amp;#39;c&amp;#39;: &amp;#39;c&amp;#39;, &amp;#39;d&amp;#39;: {&amp;#39;e&amp;#39;: &amp;#39;e&amp;#39;}}}
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div></description></item></channel></rss>