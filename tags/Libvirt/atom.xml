;color:#9ECBFF&quot;&gt; cpuid&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; tsc_known_freq&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; pni&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; pclmulqdq&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; ssse3&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; fma&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; cx16&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; pcid&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; sse4_1&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; sse4_2&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; x2apic&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; movbe&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; popcnt&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; tsc_deadline_timer&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; aes&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; xsave&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; avx&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; f16c&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; rdrand&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; hypervisor&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; lahf_lm&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; abm&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; invpcid_single&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; pti&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; fsgsbase&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; bmi1&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; avx2&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; smep&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; bmi2&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; erms&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&quot;&gt; invpcid&lt;/span&gt;&lt;span style=&quot;color:#9ECBFF&