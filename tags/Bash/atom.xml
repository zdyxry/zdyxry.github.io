&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>/home/black/Pictures/Wallpapers/
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>$ dirname ~/Pictures/Downloads/
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>/home/black/Pictures/
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h3 id="获取文件相对路径">
获取文件相对路径
&lt;a class="heading-link" href="#%e8%8e%b7%e5%8f%96%e6%96%87%e4%bb%b6%e7%9b%b8%e5%af%b9%e8%b7%af%e5%be%84">
&lt;i class="fa-solid fa-link" aria-hidden="true" title="链接到标题">&lt;/i>
&lt;span class="sr-only">链接到标题&lt;/span>
&lt;/a>
&lt;/h3>
&lt;div class="highlight">&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-Bash" data-lang="Bash">&lt;span style="display:flex;">&lt;span>basename&lt;span style="color:#f92672">()&lt;/span> &lt;span style="color:#f92672">{&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#75715e"># Usage: basename &amp;#34;path&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> : &lt;span style="color:#e6db74">&amp;#34;&lt;/span>&lt;span style="color:#e6db74">${&lt;/span>1%/&lt;span style="color:#e6db74">}&lt;/span>&lt;span style="color:#e6db74">&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> printf &lt;span style="color:#e6db74">&amp;#39;%s\n&amp;#39;&lt;/span> &lt;span style="color:#e6db74">&amp;#34;&lt;/span>&lt;span style="color:#e6db74">${&lt;/span>_##*/&lt;span style="color:#e6db74">}&lt;/span>&lt;span style="color:#e6db74">&amp;#34;&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#f92672">}&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>$ basename ~/Pictures/Wallpapers/1.jpg
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>1.jpg
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>$ basename ~/Pictures/Downloads/
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>Downloads
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h2 id="进度条">
进度条
&lt;a class="heading-link" href="#%e8%bf%9b%e5%ba%a6%e6%9d%a1">
&lt;i class="fa-solid fa-link" aria-hidden="true" title="链接到标题">&lt;/i>
