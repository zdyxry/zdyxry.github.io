---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);

// Count posts per tag
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
  }
}

const tags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1]);

// Calculate tag sizes for visual weight
const maxCount = Math.max(...tagCounts.values(), 1);
const minCount = Math.min(...tagCounts.values(), 1);

function getTagSize(count: number): string {
  const ratio = (count - minCount) / (maxCount - minCount || 1);
  if (ratio > 0.8) return 'large';
  if (ratio > 0.5) return 'medium';
  if (ratio > 0.2) return 'small';
  return 'tiny';
}
---

<BaseLayout title="标签" description="所有文章标签">
  <div class="tags-page">
    <header class="page-header">
      <h1>Tags</h1>
    </header>

    {tags.length > 0 ? (
      <div class="tags-cloud">
        {tags.map(([tag, count]) => {
          const size = getTagSize(count);
          return (
            <a 
              href={`/tags/${tag}`} 
              class={`tag-item ${size}`}
              title={`${count} 篇文章`}
            >
              <span class="tag-name">#{tag}</span>
              <span class="tag-count">{count}</span>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="empty-state">
        <p>还没有标签</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .tags-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-weight: 600;
    text-wrap: balance;
  }

  .subtitle {
    color: var(--text-secondary);
    margin: 0;
    font-size: 1rem;
  }

  .tags-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .tag-item {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    background: var(--background-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-secondary);
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .tag-item:hover {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
    text-decoration: none;
  }

  .tag-item.large {
    font-size: 1.125rem;
    padding: 0.625rem 1.25rem;
  }

  .tag-item.medium {
    font-size: 1rem;
    padding: 0.5rem 1rem;
  }

  .tag-item.small {
    font-size: 0.9375rem;
    padding: 0.4375rem 0.875rem;
  }

  .tag-item.tiny {
    font-size: 0.875rem;
    padding: 0.375rem 0.75rem;
  }

  .tag-name {
    font-weight: 500;
  }

  .tag-count {
    font-size: 0.75em;
    opacity: 0.7;
    background: rgba(0, 0, 0, 0.1);
    padding: 0.125rem 0.375rem;
    border-radius: 999px;
    min-width: 1.5em;
    text-align: center;
  }

  .tag-item:hover .tag-count {
    background: rgba(255, 255, 255, 0.2);
  }

  .empty-state {
    padding: 4rem 2rem;
    background: var(--background-secondary);
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .empty-state p {
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.75rem;
    }

    .tags-cloud {
      gap: 0.625rem;
    }

    .tag-item.large {
      font-size: 1rem;
    }

    .tag-item.medium {
      font-size: 0.9375rem;
    }
  }
</style>
