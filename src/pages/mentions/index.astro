---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('posts');

/**
 * Normalize keyword to URL-safe slug
 */
function normalizeKeyword(keyword: string): string {
  return keyword
    .trim()
    .toLowerCase()
    .replace(/\s+/g, '-')
    .replace(/[^a-z0-9\u4e00-\u9fa5-]/g, '');
}

// Collect all mentions from all posts (count unique posts per keyword)
const mentionsMap = new Map<string, Set<string>>();

for (const post of posts) {
  const content = typeof post.body === 'string' ? post.body : '';
  
  // Match [[keyword]] and [[keyword|display text]] syntax
  const wikiLinkRegex = /\[\[([^\]|]+)(?:\|[^\]]+)?\]\]/g;
  let match;
  
  while ((match = wikiLinkRegex.exec(content)) !== null) {
    const keyword = normalizeKeyword(match[1]);
    if (!keyword) continue;
    
    if (!mentionsMap.has(keyword)) {
      mentionsMap.set(keyword, new Set());
    }
    mentionsMap.get(keyword)!.add(post.id);
  }
  
  // Also support legacy [text](/mentions/keyword) syntax
  const legacyRegex = /\[([^\]]+)\]\(\/mentions\/([^)]+)\)/g;
  while ((match = legacyRegex.exec(content)) !== null) {
    const keyword = normalizeKeyword(match[2]);
    if (!keyword) continue;
    
    if (!mentionsMap.has(keyword)) {
      mentionsMap.set(keyword, new Set());
    }
    mentionsMap.get(keyword)!.add(post.id);
  }
}

// Convert to array with post counts and sort
const sortedMentions = Array.from(mentionsMap.entries())
  .map(([keyword, postSlugs]) => [keyword, postSlugs.size] as [string, number])
  .sort((a, b) => {
    if (b[1] !== a[1]) return b[1] - a[1];
    return a[0].localeCompare(b[0]);
  });

const title = 'Mentions';
const description = `共 ${sortedMentions.length} 个关键词被引用`;
---

<BaseLayout title={title} description={description}>
  <div class="mentions-index-page" data-pagefind-ignore>
    <header class="page-header">
      <h1>Mentions</h1>
    </header>

    {sortedMentions.length > 0 ? (
      <section class="mentions-cloud">
        {sortedMentions.map(([keyword, count]) => {
          const displayKeyword = keyword.charAt(0).toUpperCase() + keyword.slice(1);
          return (
            <a href={`/mentions/${keyword}`} class="mention-tag">
              <span class="mention-name">[[{displayKeyword}]]</span>
              <span class="mention-count">{count}</span>
            </a>
          );
        })}
      </section>
    ) : (
      <section class="empty-state">
        <p>暂无关键词引用</p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .mentions-index-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .subtitle {
    color: var(--text-secondary);
    margin: 0;
    font-size: 1rem;
  }

  .mentions-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .mention-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--background-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .mention-tag:hover,
  .mention-tag:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: white;
    text-decoration: none;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .mention-name {
    font-weight: 500;
  }

  .mention-count {
    font-size: 0.75rem;
    opacity: 0.7;
    background: rgba(0, 0, 0, 0.1);
    padding: 0.125rem 0.375rem;
    border-radius: 999px;
  }

  .mention-tag:hover .mention-count,
  .mention-tag:focus-visible .mention-count {
    background: rgba(255, 255, 255, 0.2);
  }

  .empty-state {
    text-align: center;
    padding: 3rem;
    background: var(--background-secondary);
    border-radius: 8px;
    border: 1px dashed var(--border);
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.75rem;
    }
  }
</style>
