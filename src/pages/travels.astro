---
import BaseLayout from '../layouts/BaseLayout.astro';
import TravelMap from '../components/TravelMap.tsx';
import travelsData from '../data/travels.json';

const title = '旅行地图';
const description = '记录我去过的地方。';

const places = travelsData.places;
---

<BaseLayout title={title} description={description}>
  <div class="travels-page">
    <TravelMap places={places} client:load />
  </div>
</BaseLayout>

<style>
  .travels-page {
    width: 100%;
  }

  :global(.travel-map-wrapper) {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--background);
    min-height: 520px;
    height: 60vh;
  }

  :global(.travel-map) {
    width: 100%;
    height: 100%;
    min-height: 520px;
  }

  :global(.maplibregl-popup-content) {
    background: var(--background);
    color: var(--text-primary);
    border: 1px solid var(--border);
    border-radius: 10px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
    padding: 12px;
  }

  :global(.maplibregl-popup-tip) {
    border-top-color: var(--background);
    border-bottom-color: var(--background);
  }

  @media (max-width: 768px) {
    :global(.travel-map-wrapper) {
      min-height: 360px;
      height: 50vh;
    }

    :global(.travel-map) {
      min-height: 360px;
    }
  }
</style>
