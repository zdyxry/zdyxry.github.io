---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const recentPosts = sortedPosts.slice(0, 8);

// Get all unique tags
const allTags = [...new Set(posts.flatMap(post => post.data.tags))].slice(0, 10);
---

<BaseLayout title="首页" description="Yiran Zhou's personal website" showFooterSocial={false}>
  <div class="home-page">
    <header class="page-header">
      <div class="avatar">
        <img src="/images/yiran.png" alt="Yiran Zhou" width="120" height="120" />
      </div>
      <nav class="social-nav">
        <a href="https://github.com/zdyxry/" target="_blank" rel="noopener" class="social-link">
          <SocialIcon name="github" type="filled" width={16} height={16} />
          <span>GitHub</span>
        </a>
        <span class="dot">·</span>
        <a href="https://twitter.com/zdyxry/" target="_blank" rel="noopener" class="social-link">
          <SocialIcon name="twitter" type="filled" width={16} height={16} />
          <span>Twitter</span>
        </a>
        <span class="dot">·</span>
        <a href="https://neodb.social/users/zdyxry/" target="_blank" rel="noopener" class="social-link">
          <SocialIcon name="neodb" type="filled" width={16} height={16} />
          <span>NeoDB</span>
        </a>
        <span class="dot">·</span>
        <a href="https://www.strava.com/athletes/160667061" target="_blank" rel="noopener" class="social-link">
          <SocialIcon name="strava" type="filled" width={16} height={16} />
          <span>Strava</span>
        </a>
        <span class="dot">·</span>
        <a href="/atom.xml" class="social-link">
          <SocialIcon name="rss" type="filled" width={16} height={16} />
          <span>RSS</span>
        </a>
      </nav>
    </header>

    <section class="recent-posts">
      <div class="section-header">
        <h2>最新文章</h2>
        <a href="/posts" class="view-all-link">查看全部 →</a>
      </div>
      <div class="posts-list">
        {recentPosts.map(post => (
          <PostCard post={post} />
        ))}
      </div>
      {recentPosts.length === 0 && (
        <div class="empty-state">
          <p>还没有文章，敬请期待！</p>
        </div>
      )}
    </section>


  </div>
</BaseLayout>

<style>
  .home-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding: 2rem 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .avatar img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    transition: border-color 0.2s;
  }

  .avatar img:hover {
    border-color: var(--accent);
  }

  .social-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
    padding: 0.25rem 0;
  }

  .social-link:hover,
  .social-link:focus-visible {
    color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .social-link svg {
    flex-shrink: 0;
  }

  .dot {
    color: var(--text-secondary);
    opacity: 0.4;
  }

  .recent-posts {
    margin-bottom: 3rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  h2 {
    font-size: 1.25rem;
    margin: 0;
    color: var(--text-primary);
    font-weight: 600;
  }

  .view-all-link {
    color: var(--accent);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .view-all-link:hover,
  .view-all-link:focus-visible {
    color: var(--accent-dark);
    text-decoration: underline;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty-state {
    padding: 3rem;
    background: var(--background-secondary);
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .empty-state p {
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .social-nav {
      flex-wrap: wrap;
      justify-content: center;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
