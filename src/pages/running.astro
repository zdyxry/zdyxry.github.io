---
import BaseLayout from '../layouts/BaseLayout.astro';

// 加载跑步数据
import runningJson from '../data/running.json';

const title = 'Running';
const description = '这里展示我的跑步记录统计与列表。';

const data = runningJson;
const recentRuns = data.runs.slice(0, 10);
const allRuns = data.runs;
const hasMoreRuns = data.runs.length > 10;

// 转换时长格式："1小时16分钟" -> "1h16m", "41分钟" -> "41m"
function formatDuration(duration: string): string {
  const hourMatch = duration.match(/(\d+)小时/);
  const minMatch = duration.match(/(\d+)分钟/);
  const hours = hourMatch ? parseInt(hourMatch[1]) : 0;
  const mins = minMatch ? parseInt(minMatch[1]) : 0;

  if (hours > 0 && mins > 0) {
    return `${hours}h${mins}m`;
  } else if (hours > 0) {
    return `${hours}h`;
  } else {
    return `${mins}m`;
  }
}

// 将时长转换为分钟数
function durationToMinutes(duration: string): number {
  const hourMatch = duration.match(/(\d+)小时/);
  const minMatch = duration.match(/(\d+)分钟/);
  const hours = hourMatch ? parseInt(hourMatch[1]) : 0;
  const mins = minMatch ? parseInt(minMatch[1]) : 0;
  return hours * 60 + mins;
}

// 将分钟数转换为时长字符串
function minutesToDuration(minutes: number): string {
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  if (hours > 0 && mins > 0) {
    return `${hours}小时${mins}分钟`;
  } else if (hours > 0) {
    return `${hours}小时`;
  } else {
    return `${mins}分钟`;
  }
}

// 平均时长格式："41:20" 或 "1:02:30"
function formatAvgDuration(minutes: number): string {
  if (!minutes) return '--';
  const totalSec = Math.round(minutes * 60);
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  if (h > 0) return `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
  return `${m}:${String(s).padStart(2, '0')}`;
}

// 总时长：小于 100 小时用 h:mm:ss / m:ss，否则用 xxx.x h
function formatTotalDuration(minutes: number): { value: string; unit: string } {
  if (minutes >= 6000) return { value: (minutes / 60).toFixed(1), unit: 'h' };
  const totalSec = Math.round(minutes * 60);
  const h = Math.floor(totalSec / 3600);
  const m = Math.floor((totalSec % 3600) / 60);
  const s = totalSec % 60;
  if (h > 0)
    return {
      value: `${h}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`,
      unit: ''
    };
  return { value: `${m}:${String(s).padStart(2, '0')}`, unit: '' };
}

// 秒数配速格式化：357 -> "5'57\""
function secondsToPace(sec: number): string {
  if (!sec || !isFinite(sec)) return '--';
  const totalSec = Math.round(sec);
  const m = Math.floor(totalSec / 60);
  const s = totalSec % 60;
  return `${m}'${String(s).padStart(2, '0')}"`;
}

function parseRunDate(dateStr: string): Date {
  return new Date(dateStr.replace(' ', 'T'));
}

function dateKey(d: Date): string {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

// 数字格式化：整数加千分位，小数保留 1 位
function fmtTick(v: number): string {
  return Number.isInteger(v) ? v.toLocaleString('en-US') : v.toFixed(1);
}

// 距离：保留 1 位小数 + 千分位
function fmtKm(v: number): string {
  return v.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
}

// 1 位小数，末尾 .0 去掉
function fmt1(v: number): string {
  return v.toFixed(1).replace(/\.0$/, '');
}

// 生成日期映射 - 同一天的多条记录合并
interface DaySummary {
  distance: number;
  duration: string;
  runs: typeof data.runs;
}

const dateMap = new Map<string, DaySummary>();
data.runs.forEach(run => {
  const dateStr = run.date.split(' ')[0];
  const existing = dateMap.get(dateStr);
  if (!existing) {
    dateMap.set(dateStr, {
      distance: run.distance,
      duration: run.duration,
      runs: [run]
    });
  } else {
    // 合并同一天的记录
    const totalDistance = existing.distance + run.distance;
    const totalMinutes = durationToMinutes(existing.duration) + durationToMinutes(run.duration);
    existing.runs.push(run);
    existing.distance = totalDistance;
    existing.duration = minutesToDuration(totalMinutes);
  }
});

// 获取颜色强度
function getIntensity(distance: number): number {
  if (!distance) return 0;
  if (distance < 3) return 1;
  if (distance < 5) return 2;
  if (distance < 10) return 3;
  if (distance < 15) return 4;
  return 5;
}

// ===== 年度热力图：当年 1/1 - 12/31，周列从周一开始 =====
const today = new Date();
const currentYear = today.getFullYear();
const currentMonth = today.getMonth();
const todayStart = new Date(currentYear, currentMonth, today.getDate());
const dayMs = 24 * 60 * 60 * 1000;

const heatStart = new Date(currentYear, 0, 1);
const heatEnd = new Date(currentYear, 11, 31);
const calStart = new Date(heatStart);
calStart.setDate(heatStart.getDate() - ((heatStart.getDay() + 6) % 7));

interface HeatDay {
  dateStr: string;
  state: 'normal' | 'future' | 'outside';
  intensity: number;
  title: string;
}

interface HeatWeek {
  days: HeatDay[];
  monthStart: boolean;
}

const heatWeeks: HeatWeek[] = [];
const cursor = new Date(calStart);
while (cursor <= heatEnd) {
  const days: HeatDay[] = [];
  let monthStart = false;
  for (let d = 0; d < 7; d++) {
    const date = new Date(cursor);
    const key = dateKey(date);
    const run = dateMap.get(key);
    const state: HeatDay['state'] =
      date < heatStart || date > heatEnd ? 'outside' : date > todayStart ? 'future' : 'normal';
    if (date >= heatStart && date <= heatEnd && date.getDate() === 1 && heatWeeks.length > 0)
      monthStart = true;
    days.push({
      dateStr: key,
      state,
      intensity: state === 'normal' && run ? getIntensity(run.distance) : 0,
      title: run
        ? `${key}: ${run.distance.toFixed(1)}km, ${run.duration}${run.runs.length > 1 ? ` (${run.runs.length}次)` : ''}`
        : key
    });
    cursor.setDate(cursor.getDate() + 1);
  }
  heatWeeks.push({ days, monthStart });
}

// 月份标签位置：该月 1 号所在周占整年的百分比（格子弹性填充整宽）
const heatMonths: { label: string; left: number }[] = [{ label: '1月', left: 0 }];
heatWeeks.forEach((week, idx) => {
  if (week.monthStart) {
    const first = week.days.find(d => d.dateStr.endsWith('-01'));
    if (first) {
      heatMonths.push({
        label: `${parseInt(first.dateStr.split('-')[1], 10)}月`,
        left: (idx / heatWeeks.length) * 100
      });
    }
  }
});

// ===== 周期统计（自然周 / 自然月 / 自然年 / 全部） =====
function aggregateRuns(runs: typeof data.runs) {
  const count = runs.length;
  const distance = runs.reduce((s, r) => s + r.distance, 0);
  const totalMinutes = runs.reduce((s, r) => s + durationToMinutes(r.duration), 0);
  // 心率按时长加权
  const hrWeighted = runs.reduce(
    (s, r) => s + (r.heart_rate > 0 ? r.heart_rate * Math.max(durationToMinutes(r.duration), 1) : 0),
    0
  );
  const hrMinutes = runs.reduce(
    (s, r) => s + (r.heart_rate > 0 ? Math.max(durationToMinutes(r.duration), 1) : 0),
    0
  );
  const powerRuns = runs.filter(r => r.avg_power > 0);
  return {
    count,
    distance,
    totalMinutes,
    avgPace: distance > 0 ? secondsToPace((totalMinutes * 60) / distance) : '--',
    avgHr: hrMinutes > 0 ? Math.round(hrWeighted / hrMinutes) : null,
    elevation: runs.reduce((s, r) => s + (r.elevation_gain || 0), 0),
    calories: runs.reduce((s, r) => s + (r.calories || 0), 0),
    avgPower: powerRuns.length
      ? Math.round(powerRuns.reduce((s, r) => s + r.avg_power, 0) / powerRuns.length)
      : null,
    avgDuration: count > 0 ? formatAvgDuration(totalMinutes / count) : '--'
  };
}

// ISO 周数
function isoWeek(d: Date): number {
  const date = new Date(d.getTime());
  date.setDate(date.getDate() + 3 - ((date.getDay() + 6) % 7));
  const week1 = new Date(date.getFullYear(), 0, 4);
  return (
    1 +
    Math.round(
      ((date.getTime() - week1.getTime()) / dayMs - 3 + ((week1.getDay() + 6) % 7)) / 7
    )
  );
}

interface Bucket {
  label: string;
  showLabel: boolean;
  current: boolean;
  runs: typeof data.runs;
}

function runsBetween(start: Date, end: Date) {
  return allRuns.filter(r => {
    const d = parseRunDate(r.date);
    return d >= start && d < end;
  });
}

// 周：本周一到周日
const weekStart = new Date(todayStart.getTime() - ((todayStart.getDay() + 6) % 7) * dayMs);
const weekdayNames = ['周一', '周二', '周三', '周四', '周五', '周六', '周日'];
const weekBuckets: Bucket[] = weekdayNames.map((label, i) => {
  const dayStart = new Date(weekStart.getTime() + i * dayMs);
  return {
    label,
    showLabel: true,
    current: dateKey(dayStart) === dateKey(todayStart),
    runs: runsBetween(dayStart, new Date(dayStart.getTime() + dayMs))
  };
});

// 月：本月 1 号到月末
const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
const monthBuckets: Bucket[] = Array.from({ length: daysInMonth }, (_, i) => {
  const d = i + 1;
  const dayStart = new Date(currentYear, currentMonth, d);
  return {
    label: String(d),
    showLabel: i % 3 === 0,
    current: d === today.getDate(),
    runs: runsBetween(dayStart, new Date(dayStart.getTime() + dayMs))
  };
});

// 年：当年 12 个月
const yearBuckets: Bucket[] = Array.from({ length: 12 }, (_, m) => ({
  label: `${m + 1}月`,
  showLabel: true,
  current: m === currentMonth,
  runs: allRuns.filter(r => {
    const d = parseRunDate(r.date);
    return d.getFullYear() === currentYear && d.getMonth() === m;
  })
}));

// 全部：按年份
const runYears = Array.from(new Set(allRuns.map(r => parseRunDate(r.date).getFullYear()))).sort(
  (a, b) => a - b
);
const totalBuckets: Bucket[] = runYears.map(y => ({
  label: String(y).slice(2),
  showLabel: true,
  current: y === currentYear,
  runs: allRuns.filter(r => parseRunDate(r.date).getFullYear() === y)
}));

const yearRuns = allRuns.filter(r => parseRunDate(r.date) >= heatStart);
const weekRuns = allRuns.filter(r => parseRunDate(r.date) >= weekStart);
const monthRuns = allRuns.filter(r => {
  const d = parseRunDate(r.date);
  return d.getFullYear() === currentYear && d.getMonth() === currentMonth;
});

const periodPanels = [
  {
    key: 'week',
    label: '周',
    periodTitle: `${currentYear} 年第 ${isoWeek(today)} 周`,
    buckets: weekBuckets,
    agg: aggregateRuns(weekRuns)
  },
  {
    key: 'month',
    label: '月',
    periodTitle: `${currentYear} 年 ${currentMonth + 1} 月`,
    buckets: monthBuckets,
    agg: aggregateRuns(monthRuns)
  },
  {
    key: 'year',
    label: '年',
    periodTitle: `${currentYear} 年`,
    buckets: yearBuckets,
    agg: aggregateRuns(yearRuns)
  },
  {
    key: 'total',
    label: '全部',
    periodTitle: `${runYears.length} 年`,
    buckets: totalBuckets,
    agg: aggregateRuns(allRuns)
  }
];

// ===== 柱状图指标 =====
const metricDefs = [
  {
    key: 'distance',
    label: '距离',
    unit: 'km',
    value: (b: Bucket) => b.runs.reduce((s, r) => s + r.distance, 0)
  },
  {
    key: 'duration',
    label: '时长',
    unit: 'h',
    value: (b: Bucket) => b.runs.reduce((s, r) => s + durationToMinutes(r.duration), 0) / 60
  },
  { key: 'count', label: '次数', unit: '次', value: (b: Bucket) => b.runs.length },
  {
    key: 'elevation',
    label: '爬升',
    unit: 'm',
    value: (b: Bucket) => b.runs.reduce((s, r) => s + (r.elevation_gain || 0), 0)
  },
  {
    key: 'calories',
    label: '卡路里',
    unit: 'kcal',
    value: (b: Bucket) => b.runs.reduce((s, r) => s + (r.calories || 0), 0)
  }
];

// Y 轴 nice 刻度
function niceStep(raw: number): number {
  if (raw <= 0 || !isFinite(raw)) return 1;
  const exp = Math.floor(Math.log10(raw));
  const f = raw / Math.pow(10, exp);
  const nf = f < 1.5 ? 1 : f < 3 ? 2 : f < 7 ? 5 : 10;
  return nf * Math.pow(10, exp);
}

interface MetricSeries {
  ticks: string[];
  gridlines: number[];
  points: { value: number; height: number; highlight: boolean; title: string }[];
}

function buildMetricSeries(buckets: Bucket[]): Record<string, MetricSeries> {
  const result: Record<string, MetricSeries> = {};
  metricDefs.forEach(m => {
    const values = buckets.map(b => m.value(b));
    const maxV = Math.max(...values, 0);
    const step = niceStep(maxV / 4);
    const n = maxV > 0 ? Math.ceil(maxV / step) : 1;
    const top = step * n;
    result[m.key] = {
      ticks: Array.from({ length: n + 1 }, (_, i) => {
        const v = top - i * step;
        return v === 0 ? '0' : `${fmtTick(Math.round(v * 10) / 10)} ${m.unit}`;
      }),
      gridlines: Array.from({ length: n + 1 }, (_, i) => (i / n) * 100),
      points: buckets.map((b, i) => ({
        value: values[i],
        height: top > 0 ? (values[i] / top) * 100 : 0,
        highlight: values[i] > 0 && values[i] === maxV,
        title: `${b.label}: ${fmtTick(Math.round(values[i] * 10) / 10)} ${m.unit}`
      }))
    };
  });
  return result;
}

const chartData: Record<string, Record<string, MetricSeries>> = {};
periodPanels.forEach(p => {
  chartData[p.key] = buildMetricSeries(p.buckets);
});

// ===== 统计网格 =====
const daysElapsedWeek = ((todayStart.getDay() + 6) % 7) + 1;
const daysElapsedMonth = today.getDate();
const monthsElapsed = currentMonth + 1;

function statItems(key: string, agg: ReturnType<typeof aggregateRuns>) {
  const distanceLabel = key === 'week' ? '周跑量' : key === 'month' ? '月跑量' : '总跑量';
  let second: { value: string; unit: string; label: string };
  if (key === 'week') {
    second = { value: fmt1(agg.distance / daysElapsedWeek), unit: 'km', label: '日均' };
  } else if (key === 'month') {
    second = { value: fmt1(agg.distance / daysElapsedMonth), unit: 'km', label: '日均' };
  } else if (key === 'year') {
    second = { value: fmt1(agg.distance / monthsElapsed), unit: 'km', label: '月跑量' };
  } else {
    second = { value: fmt1(agg.distance / runYears.length), unit: 'km', label: '年跑量' };
  }
  const totalDur = formatTotalDuration(agg.totalMinutes);
  return [
    { value: fmtKm(agg.distance), unit: 'km', label: distanceLabel },
    second,
    { value: agg.avgPace, unit: '/km', label: '平均配速' },
    { value: agg.avgHr !== null ? String(agg.avgHr) : '--', unit: 'bpm', label: '平均心率' },
    { value: Math.round(agg.elevation).toLocaleString('en-US'), unit: 'm', label: '累计爬升' },
    { value: Math.round(agg.calories).toLocaleString('en-US'), unit: 'kcal', label: '卡路里' },
    { value: agg.avgPower !== null ? String(agg.avgPower) : '--', unit: 'W', label: '平均功率' },
    { value: totalDur.value, unit: totalDur.unit, label: '总时长' },
    { value: agg.avgDuration, unit: '', label: '平均时长' }
  ];
}

// 心率区间标签
const hrZoneLabels: Record<number, string> = {
  0: '未知',
  1: 'Z1 恢复',
  2: 'Z2 有氧',
  3: 'Z3 节奏',
  4: 'Z4 阈值',
  5: 'Z5 最大'
};

// 心率区间颜色
const hrZoneColors: Record<number, string> = {
  0: 'var(--text-secondary)',
  1: '#4ade80',  // 绿色 - 恢复
  2: '#60a5fa',  // 蓝色 - 有氧
  3: '#fbbf24',  // 黄色 - 节奏
  4: '#fb923c',  // 橙色 - 阈值
  5: '#f87171'   // 红色 - 最大
};
---

<BaseLayout title={title} description={description}>
  <div class="running-page">
    <header class="page-header">
      <h1>Running</h1>
    </header>

    <article>
      {
        (!data || !data.stats) ? (
          <p>暂无数据。</p>
        ) : (
          <div>
            <section class="stats-card">
              {/* 运动类型 Tab */}
              <div class="sport-tabs">
                <button type="button" class="sport-tab active">跑步</button>
              </div>

              {/* 年度热力图 */}
              <div class="heatmap-section">
                <div class="heatmap-header">
                  <span class="heatmap-count">今年共跑步 {yearRuns.length} 次</span>
                  <span class="heatmap-year">{currentYear}</span>
                </div>
                <div class="heatmap-card">
                  <div class="heatmap-inner">
                    <div class="weekday-labels">
                      <span>一</span>
                      <span></span>
                      <span>三</span>
                      <span></span>
                      <span>五</span>
                      <span></span>
                      <span></span>
                    </div>
                    <div class="heatmap-main">
                      <div class="heatmap-months">
                        {heatMonths.map(m => (
                          <span style={`left: ${m.left}%`}>{m.label}</span>
                        ))}
                      </div>
                      <div class="heatmap-weeks">
                        {heatWeeks.map(week => (
                          <div class="heat-week">
                            {week.days.map(day => (
                              <div
                                class={`heat-day s-${day.state} i-${day.intensity}`}
                                {...(day.state !== 'outside' ? { 'data-tooltip': day.title } : {})}
                              />
                            ))}
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* 周期控制栏 */}
              <div class="period-bar">
                <div class="period-tabs" id="periodTabs">
                  {periodPanels.map(p => (
                    <button
                      type="button"
                      class={`period-tab ${p.key === 'year' ? 'active' : ''}`}
                      data-period={p.key}
                      data-title={p.periodTitle}
                    >
                      {p.label}
                    </button>
                  ))}
                  <span class="period-tab-pill" id="periodTabPill"></span>
                </div>
                <div class="period-title" id="periodTitle">{currentYear} 年</div>
                <div class="metric-menu" id="metricMenu">
                  <button type="button" class="metric-btn" id="metricBtn">
                    <span id="metricLabel">距离</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"></path></svg>
                  </button>
                  <div class="metric-dropdown" id="metricDropdown">
                    {metricDefs.map(m => (
                      <button
                        type="button"
                        class={`metric-option ${m.key === 'distance' ? 'active' : ''}`}
                        data-metric={m.key}
                        data-label={m.label}
                      >
                        {m.label}
                      </button>
                    ))}
                  </div>
                </div>
              </div>

              {/* 周期面板：柱状图 + 统计网格 */}
              {periodPanels.map(p => {
                const series = chartData[p.key].distance;
                return (
                  <div class={`period-panel ${p.key === 'year' ? 'active' : ''}`} data-panel={p.key}>
                    <div class="chart-stats">
                      <div class="bar-chart" data-period-chart={p.key}>
                        <div class="chart-main">
                          <div class="y-axis">
                            {series.ticks.map(t => (
                              <span class="y-tick">{t}</span>
                            ))}
                          </div>
                          <div class="plot-wrap">
                            <div class="plot-area">
                              <div class="gridlines">
                                {series.gridlines.map(g => (
                                  <div class="gridline" style={`bottom: ${g}%`} />
                                ))}
                              </div>
                              <div class="bar-chart-bars">
                                {series.points.map((pt, i) => (
                                  <div class="bar-col" data-tooltip={pt.title}>
                                    <div
                                      class={`bar ${pt.highlight ? 'highlight' : ''}`}
                                      style={`height: ${pt.height}%`}
                                    />
                                  </div>
                                ))}
                              </div>
                            </div>
                            <div class="x-labels">
                              {p.buckets.map(b => (
                                <span class={b.current ? 'current' : ''}>
                                  {b.showLabel ? b.label : ''}
                                </span>
                              ))}
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="stats-panel">
                        <div class="stats-grid">
                          {statItems(p.key, p.agg).map(item => (
                            <div class="stat-item">
                              <span class="stat-item-value">
                                {item.value}
                                {item.unit && <span class="stat-item-unit">{item.unit}</span>}
                              </span>
                              <span class="stat-item-label">{item.label}</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </section>

            {/* 柱状图数据（指标切换用） */}
            <script type="application/json" id="chartData" set:html={JSON.stringify(chartData)} />

            <h2 class="section-title">最近活动</h2>
            <div class="run-list" id="runList" data-all-runs={JSON.stringify(allRuns)} data-hr-zone-labels={JSON.stringify(hrZoneLabels)} data-hr-zone-colors={JSON.stringify(hrZoneColors)}>
              {recentRuns.map((run, index) => (
                <div class="run-card" data-run-index={index} data-run={JSON.stringify(run)}>
                  <div class="run-main">
                    <div class="run-header">
                      <time class="run-date">{run.date.split(' ')[0]}</time>
                      {run.hr_zone > 0 && (
                        <span
                          class="hr-zone-badge"
                          style={`background-color: ${hrZoneColors[run.hr_zone]}20; color: ${hrZoneColors[run.hr_zone]}; border: 1px solid ${hrZoneColors[run.hr_zone]}40;`}
                        >
                          {hrZoneLabels[run.hr_zone]}
                        </span>
                      )}
                    </div>
                    <span class="run-type">
                      {run.activity_type || '室外跑步'}
                      {run.workout_name && (
                        <span class="workout-name"> · {run.workout_name}</span>
                      )}
                    </span>
                  </div>
                  <div class="run-stats">
                    <div class="stat">
                      <span class="stat-value">{run.distance.toFixed(1)}</span>
                      <span class="stat-label">km</span>
                    </div>
                    <div class="stat">
                      <span class="stat-value">{formatDuration(run.duration)}</span>
                      <span class="stat-label">时长</span>
                    </div>
                    <div class="stat">
                      <span class="stat-value">{run.pace}</span>
                      <span class="stat-label">配速</span>
                    </div>
                    <div class="stat vdot-stat">
                      <span class="stat-value">{run.vdot ?? '-'}</span>
                      <span class="stat-label">VDOT</span>
                    </div>
                    {run.training_load > 0 && (
                      <div class="stat load-stat">
                        <span class="stat-value">{run.training_load}</span>
                        <span class="stat-label">负荷</span>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
            {hasMoreRuns && (
              <button class="load-more-btn" id="loadMoreBtn">
                <span>更多</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
            )}
          </div>
        )
      }
    </article>
  </div>

  <!-- 运动详情弹窗 -->
  <div class="run-detail-modal" id="runDetailModal">
    <div class="modal-overlay"></div>
    <div class="modal-content">
      <button class="modal-close" id="modalClose">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div class="modal-body" id="modalBody">
        <!-- 动态内容 -->
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // 周期 Tab 切换（滑动指示块 + 面板切换）
  const periodTabs = document.getElementById('periodTabs');
  if (periodTabs) {
    const pill = document.getElementById('periodTabPill');
    const titleEl = document.getElementById('periodTitle');

    function movePill(btn) {
      if (!pill) return;
      pill.style.left = btn.offsetLeft + 'px';
      pill.style.width = btn.offsetWidth + 'px';
    }

    function initPill() {
      const activeBtn = periodTabs.querySelector('.period-tab.active');
      if (activeBtn) movePill(activeBtn);
    }

    initPill();
    window.addEventListener('resize', initPill);

    periodTabs.addEventListener('click', function(e) {
      const btn = e.target.closest('.period-tab');
      if (!btn) return;

      periodTabs.querySelectorAll('.period-tab').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      movePill(btn);

      if (titleEl && btn.dataset.title) {
        titleEl.textContent = btn.dataset.title;
      }

      document.querySelectorAll('.period-panel').forEach(panel => {
        panel.classList.toggle('active', panel.dataset.panel === btn.dataset.period);
      });
    });
  }

  // 柱状图跟随鼠标的 tooltip
  const chartTooltip = document.createElement('div');
  chartTooltip.className = 'chart-tooltip';
  document.body.appendChild(chartTooltip);

  document.querySelectorAll('.bar-chart-bars').forEach(bars => {
    bars.addEventListener('mousemove', e => {
      const col = e.target.closest('.bar-col');
      if (!col || !col.dataset.tooltip) {
        chartTooltip.classList.remove('visible');
        return;
      }
      chartTooltip.textContent = col.dataset.tooltip;
      chartTooltip.style.left = e.clientX + 'px';
      chartTooltip.style.top = e.clientY + 'px';
      chartTooltip.classList.add('visible');
    });
    bars.addEventListener('mouseleave', () => chartTooltip.classList.remove('visible'));
  });

  // 柱状图指标切换
  const chartDataEl = document.getElementById('chartData');
  const metricMenu = document.getElementById('metricMenu');
  if (chartDataEl && metricMenu) {
    const chartData = JSON.parse(chartDataEl.textContent || '{}');
    const metricBtn = document.getElementById('metricBtn');
    const metricLabel = document.getElementById('metricLabel');

    function renderCharts(metric) {
      document.querySelectorAll('[data-period-chart]').forEach(chart => {
        const d = chartData[chart.dataset.periodChart]?.[metric];
        if (!d) return;
        const yAxis = chart.querySelector('.y-axis');
        if (yAxis) {
          yAxis.innerHTML = d.ticks.map(t => `<span class="y-tick">${t}</span>`).join('');
        }
        const gridlines = chart.querySelector('.gridlines');
        if (gridlines) {
          gridlines.innerHTML = d.gridlines
            .map(g => `<div class="gridline" style="bottom: ${g}%"></div>`)
            .join('');
        }
        chart.querySelectorAll('.bar').forEach((bar, i) => {
          const p = d.points[i];
          if (!p) return;
          bar.style.height = p.height + '%';
          bar.classList.toggle('highlight', p.highlight);
          bar.closest('.bar-col')?.setAttribute('data-tooltip', p.title);
        });
      });
    }

    metricBtn?.addEventListener('click', e => {
      e.stopPropagation();
      metricMenu.classList.toggle('open');
    });

    document.addEventListener('click', e => {
      if (!metricMenu.contains(e.target)) {
        metricMenu.classList.remove('open');
      }
    });

    metricMenu.querySelectorAll('.metric-option').forEach(opt => {
      opt.addEventListener('click', () => {
        metricMenu.querySelectorAll('.metric-option').forEach(o => o.classList.remove('active'));
        opt.classList.add('active');
        if (metricLabel && opt.dataset.label) metricLabel.textContent = opt.dataset.label;
        metricMenu.classList.remove('open');
        if (opt.dataset.metric) renderCharts(opt.dataset.metric);
      });
    });
  }

  // 时长格式化函数
  function formatDuration(duration) {
    const hourMatch = duration.match(/(\d+)小时/);
    const minMatch = duration.match(/(\d+)分钟/);
    const hours = hourMatch ? parseInt(hourMatch[1]) : 0;
    const mins = minMatch ? parseInt(minMatch[1]) : 0;

    if (hours > 0 && mins > 0) {
      return `${hours}h${mins}m`;
    } else if (hours > 0) {
      return `${hours}h`;
    } else {
      return `${mins}m`;
    }
  }

  // 心率区间标签
  const hrZoneLabels = {
    0: '未知',
    1: 'Z1 恢复',
    2: 'Z2 有氧',
    3: 'Z3 节奏',
    4: 'Z4 阈值',
    5: 'Z5 最大'
  };

  // 心率区间颜色
  const hrZoneColors = {
    0: 'var(--text-secondary)',
    1: '#4ade80',
    2: '#60a5fa',
    3: '#fbbf24',
    4: '#fb923c',
    5: '#f87171'
  };

  // 查看更多功能
  const loadMoreBtn = document.getElementById('loadMoreBtn');
  const runList = document.getElementById('runList');

  if (loadMoreBtn && runList) {
    const allRuns = JSON.parse(runList.dataset.allRuns || '[]');
    let isExpanded = false;

    loadMoreBtn.addEventListener('click', () => {
      if (!isExpanded) {
        // 展开显示全部
        const remainingRuns = allRuns.slice(10);
        remainingRuns.forEach((run, idx) => {
          const runCard = document.createElement('div');
          runCard.className = 'run-card';
          runCard.style.animation = 'fadeIn 0.3s ease';
          runCard.dataset.runIndex = 10 + idx;
          runCard.dataset.run = JSON.stringify(run);

          const hrZoneBadge = run.hr_zone > 0 ? `
            <span
              class="hr-zone-badge"
              style="background-color: ${hrZoneColors[run.hr_zone]}20; color: ${hrZoneColors[run.hr_zone]}; border: 1px solid ${hrZoneColors[run.hr_zone]}40;"
            >
              ${hrZoneLabels[run.hr_zone]}
            </span>
          ` : '';

          const vdotStat = `
            <div class="stat vdot-stat">
              <span class="stat-value">${run.vdot ?? '-'}</span>
              <span class="stat-label">VDOT</span>
            </div>
          `;

          const loadStat = run.training_load > 0 ? `
            <div class="stat load-stat">
              <span class="stat-value">${run.training_load}</span>
              <span class="stat-label">负荷</span>
            </div>
          ` : '';

          runCard.innerHTML = `
            <div class="run-main">
              <div class="run-header">
                <time class="run-date">${run.date.split(' ')[0]}</time>
                ${hrZoneBadge}
              </div>
              <span class="run-type">
                ${run.activity_type || '室外跑步'}
                ${run.workout_name ? `<span class="workout-name"> · ${run.workout_name}</span>` : ''}
              </span>
            </div>
            <div class="run-stats">
              <div class="stat">
                <span class="stat-value">${run.distance.toFixed(1)}</span>
                <span class="stat-label">km</span>
              </div>
              <div class="stat">
                <span class="stat-value">${formatDuration(run.duration)}</span>
                <span class="stat-label">时长</span>
              </div>
              <div class="stat">
                <span class="stat-value">${run.pace}</span>
                <span class="stat-label">配速</span>
              </div>
              ${vdotStat}
              ${loadStat}
            </div>
          `;

          // 添加点击事件
          runCard.addEventListener('click', () => openModal(run));

          runList.appendChild(runCard);
        });

        loadMoreBtn.innerHTML = `
          <span>收起</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="transform: rotate(180deg);"><polyline points="6 9 12 15 18 9"></polyline></svg>
        `;
        isExpanded = true;
      } else {
        // 收起，只保留前10条
        const allCards = runList.querySelectorAll('.run-card');
        allCards.forEach((card, index) => {
          if (index >= 10) {
            card.remove();
          }
        });

        loadMoreBtn.innerHTML = `
          <span>更多</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
        `;
        isExpanded = false;

        // 滚动回列表顶部
        runList.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }

  // 详情弹窗功能
  const modal = document.getElementById('runDetailModal');
  const modalBody = document.getElementById('modalBody');
  const modalClose = document.getElementById('modalClose');
  const modalOverlay = modal?.querySelector('.modal-overlay');

  function openModal(run) {
    if (!modal || !modalBody) return;

    // 生成心率区间徽章
    const hrZoneBadge = run.hr_zone > 0 ? `
      <span class="detail-hr-zone" style="background-color: ${hrZoneColors[run.hr_zone]}20; color: ${hrZoneColors[run.hr_zone]}; border: 1px solid ${hrZoneColors[run.hr_zone]}40;">
        ${hrZoneLabels[run.hr_zone]}
      </span>
    ` : '';

    // SVG 图标定义
    const icons = {
      distance: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>`,
      duration: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
      pace: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>`,
      heartRate: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>`,
      cadence: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="1"></circle><path d="M9 20l3-6 3 6"></path><path d="M6 8l6 2 6-2"></path><path d="M12 10V4"></path></svg>`,
      stride: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"></path><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6"></path><path d="M12 2v10"></path></svg>`,
      power: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg>`,
      calories: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path></svg>`,
      elevation: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>`,
      vdot: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>`,
      load: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"></path><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"></path><path d="M4 22h16"></path><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"></path><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"></path><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"></path></svg>`
    };

    // 生成详细统计数据
    const detailStats = [];

    // 基础数据
    detailStats.push({
      icon: icons.distance,
      label: '距离',
      value: `${run.distance.toFixed(2)} km`
    });

    detailStats.push({
      icon: icons.duration,
      label: '移动时间',
      value: formatDuration(run.duration)
    });

    detailStats.push({
      icon: icons.duration,
      label: '总时间',
      value: formatDuration(run.duration)
    });

    detailStats.push({
      icon: icons.pace,
      label: '配速',
      value: `${run.pace} /km`
    });

    // 心率数据
    if (run.heart_rate > 0) {
      detailStats.push({
        icon: icons.heartRate,
        label: '平均心率',
        value: `${Math.round(run.heart_rate)} bpm`
      });
    }

    // 最大心率（如果有）
    if (run.max_heart_rate > 0) {
      detailStats.push({
        icon: icons.heartRate,
        label: '最大心率',
        value: `${Math.round(run.max_heart_rate)} bpm`
      });
    }

    // 步频
    if (run.cadence > 0) {
      detailStats.push({
        icon: icons.cadence,
        label: '步频',
        value: `${Math.round(run.cadence)} spm`
      });
    }

    // 步幅
    if (run.stride_length > 0) {
      detailStats.push({
        icon: icons.stride,
        label: '步幅',
        value: `${Math.round(run.stride_length)} cm`
      });
    }

    // 功率
    if (run.avg_power > 0) {
      detailStats.push({
        icon: icons.power,
        label: '平均功率',
        value: `${Math.round(run.avg_power)} w`
      });
    }

    if (run.max_power > 0) {
      detailStats.push({
        icon: icons.power,
        label: '最大功率',
        value: `${Math.round(run.max_power)} w`
      });
    }

    // 卡路里
    if (run.calories > 0) {
      detailStats.push({
        icon: icons.calories,
        label: '热量消耗',
        value: `${Math.round(run.calories)} kcal`
      });
    }

    // 爬升
    if (run.elevation_gain > 0) {
      detailStats.push({
        icon: icons.elevation,
        label: '累计爬升',
        value: `${Math.round(run.elevation_gain)} m`
      });
    }

    // VDOT
    if (run.vdot > 0) {
      detailStats.push({
        icon: icons.vdot,
        label: 'VDOT',
        value: run.vdot.toFixed(1)
      });
    }

    // 训练负荷
    if (run.training_load > 0) {
      detailStats.push({
        icon: icons.load,
        label: '训练负荷',
        value: run.training_load
      });
    }

    // 辅助函数：将配速字符串转换为秒数
    function paceToSeconds(paceStr) {
      if (!paceStr || paceStr === "0'00\"") return 0;
      const match = paceStr.match(/(\d+)'(\d+)/);
      if (match) {
        return parseInt(match[1]) * 60 + parseInt(match[2]);
      }
      return 0;
    }

    // 辅助函数：计算配速柱状图宽度
    // 使用非线性映射，让快慢配速差异更明显
    // 配速范围：4'00" (240s) 到 8'00" (480s)
    function getPaceBarWidth(paceStr, allPaces = []) {
      const paceSeconds = paceToSeconds(paceStr);
      if (paceSeconds === 0) return 0;

      // 如果有多个配速，使用相对比例
      if (allPaces.length > 1) {
        const allSeconds = allPaces.map(p => paceToSeconds(p)).filter(s => s > 0);
        if (allSeconds.length > 1) {
          const minPace = Math.min(...allSeconds);
          const maxPace = Math.max(...allSeconds);
          const range = maxPace - minPace;
          if (range > 0) {
            // 越快的配速（数值越小），宽度越宽
            // 使用反向映射：(max - current) / range
            const ratio = (maxPace - paceSeconds) / range;
            // 最小宽度 30%，最大 100%
            return Math.max(30, Math.min(100, 30 + ratio * 70));
          }
        }
      }

      // 默认映射：4'00" = 100%, 8'00" = 20%
      const minSeconds = 240;  // 4'00"
      const maxSeconds = 480;  // 8'00"
      const ratio = (maxSeconds - paceSeconds) / (maxSeconds - minSeconds);
      return Math.max(20, Math.min(100, 20 + ratio * 80));
    }

    // 辅助函数：根据配速获取颜色类
    // fast: < 5'30" (330s), medium: 5'30" - 7'00" (420s), slow: > 7'00"
    function getPaceBarClass(paceStr) {
      const paceSeconds = paceToSeconds(paceStr);
      if (paceSeconds === 0) return 'medium';

      if (paceSeconds < 330) {  // < 5'30"
        return 'fast';
      } else if (paceSeconds > 420) {  // > 7'00"
        return 'slow';
      } else {
        return 'medium';
      }
    }

    // 生成分段数据表格（如果有）
    let segmentsHtml = '';
    if (run.segments && run.segments.length > 0) {
      // 收集所有配速用于相对比例计算
      const allSegmentPaces = run.segments.map(s => s.pace).filter(p => p && p !== "0'00\"");

      const segmentRows = run.segments.map((seg, idx) => {
        const zoneClass = seg.hr_zone ? `zone-${seg.hr_zone}` : '';
        const zoneLabel = seg.hr_zone ? hrZoneLabels[seg.hr_zone]?.split(' ')[0] : '';
        const barWidth = getPaceBarWidth(seg.pace, allSegmentPaces);
        const barClass = getPaceBarClass(seg.pace);
        return `
          <tr>
            <td>${seg.km || idx + 1}</td>
            <td>
              <div class="pace-bar">
                <div class="pace-bar-fill ${barClass}" style="width: ${barWidth}%"></div>
                <span>${seg.pace}</span>
              </div>
            </td>
            <td>${seg.gap || seg.pace}</td>
            <td>
              <span class="hr-zone-tag ${zoneClass}">${seg.heart_rate || '-'} ${zoneLabel}</span>
            </td>
          </tr>
        `;
      }).join('');

      segmentsHtml = `
        <div class="detail-section">
          <h4 class="section-subtitle">分段数据</h4>
          <div class="segments-table-wrapper">
            <table class="segments-table">
              <thead>
                <tr>
                  <th>公里</th>
                  <th>配速</th>
                  <th>GAP</th>
                  <th>心率</th>
                </tr>
              </thead>
              <tbody>
                ${segmentRows}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    // 生成记圈数据表格（如果有）
    let lapsHtml = '';
    if (run.laps && run.laps.length > 0) {
      const lapRows = run.laps.map((lap, idx) => {
        const zoneClass = lap.hr_zone ? `zone-${lap.hr_zone}` : '';
        const zoneLabel = lap.hr_zone ? hrZoneLabels[lap.hr_zone]?.split(' ')[0] : '';
        return `
          <tr>
            <td>${idx + 1}</td>
            <td>${lap.distance?.toFixed(2) || '-'}</td>
            <td>
              <span class="pace-tag ${zoneClass}">${lap.pace || '-'}</span>
            </td>
            <td>${lap.cadence || '-'}</td>
            <td>${lap.power || '-'}</td>
            <td>
              <span class="hr-zone-tag ${zoneClass}">${lap.heart_rate || '-'} ${zoneLabel}</span>
            </td>
          </tr>
        `;
      }).join('');

      lapsHtml = `
        <div class="detail-section">
          <h4 class="section-subtitle">记圈数据</h4>
          <div class="laps-table-wrapper">
            <table class="laps-table">
              <thead>
                <tr>
                  <th>圈</th>
                  <th>距离(km)</th>
                  <th>配速</th>
                  <th>步频</th>
                  <th>功率</th>
                  <th>心率</th>
                </tr>
              </thead>
              <tbody>
                ${lapRows}
              </tbody>
            </table>
          </div>
        </div>
      `;
    }

    modalBody.innerHTML = `
      <div class="detail-header">
        <h3 class="detail-title">${run.workout_name || '跑步'}</h3>
        <div class="detail-meta">
          <span class="detail-date">${run.date}</span>
          ${hrZoneBadge}
          <span class="detail-type">${run.activity_type || '室外跑步'}</span>
        </div>
      </div>

      <div class="detail-stats-grid">
        ${detailStats.map(stat => `
          <div class="detail-stat-item">
            <span class="detail-stat-icon">${stat.icon}</span>
            <span class="detail-stat-label">${stat.label}</span>
            <span class="detail-stat-value">${stat.value}</span>
          </div>
        `).join('')}
      </div>

      ${segmentsHtml}
      ${lapsHtml}
    `;

    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('active');
    document.body.style.overflow = '';
  }

  // 为初始的跑步卡片添加点击事件
  document.querySelectorAll('.run-card').forEach(card => {
    card.addEventListener('click', () => {
      const runData = card.dataset.run;
      if (runData) {
        openModal(JSON.parse(runData));
      }
    });
  });

  // 关闭弹窗事件
  modalClose?.addEventListener('click', closeModal);
  modalOverlay?.addEventListener('click', closeModal);

  // ESC键关闭弹窗
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>

