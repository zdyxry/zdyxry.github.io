---
import { getBacklinks } from '../utils/backlinks';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const backlinks = await getBacklinks(currentSlug);
---

{backlinks.length > 0 && (
  <section class="backlinks">
    <h3>双向链接</h3>
    <ul>
      {backlinks.map(link => (
        <li>
          <a href={`/${link.slug}/`}>
            ← {link.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .backlinks {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  h3 {
    font-size: 1.125rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  li {
    margin: 0;
  }

  li a {
    color: var(--accent);
    display: block;
    padding: 0.5rem 0.75rem;
    background: var(--background-secondary);
    border-radius: 6px;
    border: 1px solid var(--border);
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    text-decoration: none;
  }

  li a:hover {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .backlinks {
      margin-top: 2rem;
      padding-top: 1.5rem;
    }
  }
</style>
