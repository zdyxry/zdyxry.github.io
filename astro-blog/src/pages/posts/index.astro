---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Group posts by year
const postsByYear = new Map<number, typeof posts>();
for (const post of sortedPosts) {
  const year = post.data.pubDate.getFullYear();
  if (!postsByYear.has(year)) {
    postsByYear.set(year, []);
  }
  postsByYear.get(year)!.push(post);
}

const years = Array.from(postsByYear.keys()).sort((a, b) => b - a);

// Calculate total stats
const totalWords = posts.reduce((sum, post) => {
  const content = typeof post.body === 'string' ? post.body : '';
  return sum + content.split(/\s+/).length;
}, 0);
---

<BaseLayout title="文章" description="所有博客文章">
  <div class="posts-page">
    <header class="page-header">
      <h1>文章</h1>
      <p class="subtitle">
        共 {sortedPosts.length} 篇文章 · {totalWords.toLocaleString()} 字
      </p>
    </header>

    {years.length > 0 ? (
      <div class="posts-timeline">
        {years.map(year => (
          <section class="year-section">
            <div class="year-header">
              <h2>{year}</h2>
              <span class="year-count">{postsByYear.get(year)!.length} 篇</span>
            </div>
            <div class="posts-list">
              {postsByYear.get(year)!.map(post => (
                <PostCard post={post} showYear={false} />
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>还没有文章，敬请期待！</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .posts-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-weight: 600;
    text-wrap: balance;
  }

  .subtitle {
    color: var(--text-secondary);
    margin: 0;
    font-size: 1rem;
  }

  .posts-timeline {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .year-section {
    position: relative;
  }

  .year-header {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .year-section h2 {
    font-size: 1.5rem;
    color: var(--text-primary);
    margin: 0;
    font-weight: 600;
    text-wrap: balance;
  }

  .year-count {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .empty-state {
    padding: 4rem 2rem;
    background: var(--background-secondary);
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .empty-state p {
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.75rem;
    }

    .year-section h2 {
      font-size: 1.375rem;
    }

    .posts-timeline {
      gap: 2rem;
    }
  }
</style>
