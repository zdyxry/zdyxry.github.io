---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Friends';
const description = '友链 - 朋友们的博客';

const friends = [
  { name: "Jiajun的编程随想", url: "https://jiajunhuang.com/" },
  { name: "格物致知", url: "https://liqiang.io/" },
  { name: "玻璃齿轮 - SlassGear", url: "https://blog.winkidney.com/" },
  { name: "CosPotato's Blog", url: "https://blog.0x233.cn/" },
  { name: "Joker", url: "https://quartz.19960312.xyz/" },
  { name: "fanyang's blog", url: "https://fuis.top/" },
];
---

<BaseLayout title={title} description={description}>
  <div class="friends-page">
    <header class="page-header">
      <h1>Friends</h1>
    </header>

    <section class="friends-list">
      {friends.map(friend => (
        <a href={friend.url} target="_blank" rel="noopener noreferrer" class="friend-card">
          <div class="friend-name">{friend.name}</div>
          <div class="friend-url">{friend.url}</div>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .friends-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
    font-weight: 600;
    text-wrap: balance;
  }

  .subtitle {
    color: var(--text-secondary);
    margin: 0;
    font-size: 1rem;
  }

  .friends-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .friend-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    background: var(--background-secondary);
    border-radius: 8px;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
    min-width: 0;
  }

  .friend-card:hover,
  .friend-card:focus-visible {
    border-color: var(--accent);
    background: var(--background);
    text-decoration: none;
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 8px;
  }

  .friend-name {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    text-wrap: balance;
    flex-shrink: 0;
  }

  .friend-url {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 50%;
  }

  .friend-card:hover .friend-name {
    color: var(--accent);
  }

  .friend-card:hover .friend-url,
  .friend-card:focus-visible .friend-url {
    color: var(--accent);
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 1.75rem;
    }

    .friend-card {
      padding: 0.875rem 1rem;
    }
  }
</style>
